    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18"
  },
  "keywords": [
    "agmon",
    "agent-monitor",
    "antigravity",
    "claude-code",
    "ai-agent",
