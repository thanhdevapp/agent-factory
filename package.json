{
  "name": "agmon",
  "version": "0.2.0",
  "description": "Realtime AI Agent Office & Activity Visualizer for Antigravity, Claude Code & AI CLIs",
  "type": "module",
  "bin": {
    "agmon": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    ".next",
    "jsconfig.json",
    "next.config.mjs",
    "postcss.config.mjs",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev --port 3030",
    "build": "next build",
    "start": "next start --port 3030",
